repository-code: "https://github.com/ASU-Ziyi-Zhang/bay-area-uam-link-quality-simulator"
url: "https://asu-ziyi-zhang.github.io/bay-area-uam-link-quality-simulator/"
keywords:
  - urban air mobility
  - link quality
  - RSRP
  - SINR
  - cellular connectivity
  - reproducible research
  - adaptive cruise control
  - lane change
  - airspace capacity
